# ==============================================================================
# SkyOps Kubernetes Incident Intelligence Platform - Environment Configuration
# ==============================================================================

# Deployment Mode: "self-hosted" or "cloud" (Defaults to self-hosted)
DEPLOYMENT_MODE=self-hosted

# Data Privacy: When self-hosted, telemetry is strictly local (default: false)
DATA_TELEMETRY_ENABLED=false

# Database Configuration: PostgreSQL connection string
# If omitted or offline, SkyOps automatically operates with an embedded high-performance repository.
DATABASE_URL=postgres://skyops:skyops_secure_password@postgres:5432/skyops?sslmode=disable

# Authentication Secrets
JWT_SECRET=skyops-production-jwt-secret-replace-with-secure-key
JWT_EXPIRES_IN=24h

# License Signing Secret (Offline HMAC-SHA256 signature verification)
LICENSE_SIGNING_SECRET=skyops-license-core-signing-secret-v1

# Initial Admin Bootstrap Credentials (Used during initial startup initialization)
INITIAL_ADMIN_EMAIL=admin@skyops.io
INITIAL_ADMIN_PASSWORD=SkyOpsAdmin123!

# AI Intelligence Diagnostics (Optional: If provided, activates deep Gemini RCA; if omitted, deterministic local RCA engine runs)
GEMINI_API_KEY=

# Public Control Plane URL
APP_URL=http://localhost:3000
